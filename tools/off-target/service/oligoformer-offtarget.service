# OligoFormer off-target 内网 SaaS —— systemd 单元（部署时复制到 /etc/systemd/system/）
[Unit]
Description=OligoFormer Off-target SaaS (siRNA efficacy/off-target/toxicity)
After=network.target

[Service]
Type=simple
User=aiuser
WorkingDirectory=/export/projects/sandbox/oligolab/tools/off-target/service
Environment=OFFTARGET_PORT=7131
ExecStart=/bin/bash /export/projects/sandbox/oligolab/tools/off-target/service/run_prod.sh
Restart=always
RestartSec=5
# 推理是重型 GPU 任务，串行单例
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
